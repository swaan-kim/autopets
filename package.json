{
  "name": "autopets-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @autopets/desktop dev",
    "build": "pnpm --filter @autopets/desktop build",
    "test": "node scripts/run-tests.mjs",
    "test:ui": "node scripts/ci-ui.mjs",
    "desktop": "pnpm --filter @autopets/desktop desktop",
    "desktop:build": "pnpm --filter @autopets/desktop desktop:build",
    "hooks:check": "node scripts/check-hooks.mjs",
    "evaluate:assistance": "node scripts/evaluate-assistance.mjs",
    "package:chatgpt": "node scripts/package-chatgpt.mjs",
    "test:rust": "cargo test --locked --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "verify:layout": "node scripts/verify-layout.mjs && node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "packageManager": "pnpm@11.19.0"
}
