{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoPet Preview",
  "version": "0.0.1",
  "identifier": "local.autopets.petpreview",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": ["pet"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../desktop/src-tauri/icons/icon.png", "../../desktop/src-tauri/icons/icon.ico"]
  }
}
