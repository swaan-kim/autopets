{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoPets",
  "version": "0.1.0",
  "identifier": "local.autopets.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"AutoPets · 작은 작업 동료","width":1120,"height":880,"minWidth":760,"minHeight":640,"center":true}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {"active":false,"icon":["icons/icon.png","icons/icon.ico"]}
}
